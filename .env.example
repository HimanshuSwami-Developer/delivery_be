# Copy this to .env and fill in real values. core/settings.py loads this
# file automatically via python-dotenv.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Postgres connection string (Neon or any Postgres host). Required — there
# is no sqlite fallback.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary (product image uploads) — from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Unsigned upload preset name (Settings → Upload → Upload presets, mode "Unsigned").
CLOUDINARY_UPLOAD_PRESET=uploads

# OTP behaviour
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=3
RESEND_OTP_WAIT_SECONDS=30

# Master OTP (bypasses real SMS entirely) — CHANGE THIS, keep it secret
MASTER_OTP=1234
# Comma separated list of numbers allowed to use the master OTP.
# Leave blank to allow ANY number (fine for dev, NOT recommended for prod).
MASTER_OTP_MOBILE_NUMBERS=

# OTP delivery: "console" (dev, prints OTP) or "fast2sms" (plain SMS via
# Fast2SMS's Quick SMS route)
SMS_BACKEND=console

# Fast2SMS (used when SMS_BACKEND=fast2sms). fast2sms.com dashboard ->
# Dev API -> API Keys.
FAST2SMS_API_KEY=your_fast2sms_api_key

# Who receives the order-invoice SMS every time an order is placed
# (digits with country code, no '+').
ORDER_NOTIFY_MOBILE_NUMBER=919718751020

# Push notifications (FCM) — path to the Firebase service-account JSON key.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Leave blank to disable sending (logs instead).
FIREBASE_CREDENTIALS_PATH=

# Groq (OCR for QR payment screenshots) — from console.groq.com. Leave
# blank to skip auto-approval: QR orders still place fine, just stay
# payment_status='pending' for an admin to verify by hand.
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
